# Copie para .env (copy .env.exemplo .env) e troque as senhas.
# Variaveis do ambiente do sistema tem prioridade sobre este arquivo.
# Use 127.0.0.1 em vez de localhost para evitar diferencas IPv4/IPv6.

# Nomes dos bancos. NUNCA use "postgres": criar_bancos.py apaga estes bancos.
DIARIO_DB=diario_saude
CENTRAL_DB=central_transplantes

# Conexao SEM prefixo: usada por criar_bancos.py, demo_backend.py e pelos
# testes, e tambem como valor padrao quando falta uma variavel com prefixo.
# ATENCAO: criar_bancos.py (e demo_backend.py, sem --sem-recriar) faz DROP e
# CREATE de DIARIO_DB e CENTRAL_DB no servidor indicado aqui.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=sua_senha_aqui
PGSSLMODE=prefer

# Conexao do Diario de Saude (tem prioridade sobre as variaveis sem prefixo).
DIARIO_PGHOST=127.0.0.1
DIARIO_PGPORT=5432
DIARIO_PGUSER=postgres
DIARIO_PGPASSWORD=sua_senha_aqui
DIARIO_PGSSLMODE=prefer

# Conexao da Central de Transplantes (tem prioridade sobre as sem prefixo).
CENTRAL_PGHOST=127.0.0.1
CENTRAL_PGPORT=5432
CENTRAL_PGUSER=postgres
CENTRAL_PGPASSWORD=sua_senha_aqui
CENTRAL_PGSSLMODE=prefer
